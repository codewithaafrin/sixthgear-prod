{
  "name": "sixthgear-website",
  "version": "1.0.0",
  "private": true,
  "description": "Sixth Gear: sixthgear.ai marketing site (static, no framework, no dependencies).",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/generate-seo.mjs",
    "build:ping": "node scripts/generate-seo.mjs --ping",
